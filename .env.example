# Copier ce fichier en .env.local et renseigner les valeurs.
# Supabase : Project Settings > API (projet dédié au Portail, pas celui de Ministry School).

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (anon ou « publishable ») : sans danger côté navigateur, la RLS protège les données.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (service_role ou « secret »). Ne jamais l'exposer au navigateur ni la préfixer
# par NEXT_PUBLIC_. Réservée aux scripts et tâches d'administration côté serveur.
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du portail : liens des e-mails (invitation, réinitialisation), métadonnées.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
